set(output "@AXIOVOX_OUTPUT_DIRECTORY@")
file(MAKE_DIRECTORY "${output}")
file(REMOVE_RECURSE "${output}/assets" "${output}/licenses")
file(COPY "@PROJECT_SOURCE_DIR@/assets" DESTINATION "${output}")
file(COPY "@PROJECT_SOURCE_DIR@/licenses" DESTINATION "${output}")
file(COPY_FILE "@PROJECT_SOURCE_DIR@/vendors/glfw/LICENSE.md" "${output}/licenses/GLFW.txt")
file(COPY_FILE "@PROJECT_SOURCE_DIR@/vendors/vma/LICENSE.txt" "${output}/licenses/VMA.txt")
set(runtime "@AXIOVOX_RUNTIME_SOURCE@")
if(NOT runtime STREQUAL "")
    get_filename_component(runtime_directory "${output}/@AXIOVOX_RUNTIME_DESTINATION@" DIRECTORY)
    file(MAKE_DIRECTORY "${runtime_directory}")
    file(COPY_FILE "${runtime}" "${output}/@AXIOVOX_RUNTIME_DESTINATION@" ONLY_IF_DIFFERENT)
endif()
